# Copier en `.env` et adapter.

# Cerveau des agents : "fake" (déterministe, sans LLM) ou "ollama" (Gemma E4B)
LLM_PROVIDER=fake

# Configuration Ollama (utilisée seulement si LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Stock initial de l'usine (sert à rendre la démo intéressante : il manquera des pièces)
# Format : piece:quantite séparés par des virgules
STOCK_INITIAL=roue:3,batterie:2,chassis:1

# Graine aléatoire pour le Fournisseur (vide = vrai aléatoire). Mettre un entier pour reproductibilité.
SEED=
