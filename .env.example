# Copier en `.env` (non suivi par git) et adapter.

# Cerveau des agents : "fake" (déterministe, sans LLM) ou "llm" (service LLM central)
LLM_PROVIDER=fake

# Service LLM central (repo LLM-Service, API compatible OpenAI), utilisé si LLM_PROVIDER=llm
# Depuis l'hôte : http://127.0.0.1:8080/v1 ; dans docker compose, l'URL est forcée à
# http://llm-central:8080/v1 (réseau llm-net).
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=chat
# Clé propre de l'application (jamais la clé maîtresse LITELLM_MASTER_KEY de LLM-Service).
# Créée et écrite ici par : ~/mes_projets/Projet-IA/LLM-Service/scripts/cle.sh creer agents-mcp-orchestration \
#   --dans <dépôt>/.env --noms LLM_BASE_URL,LLM_API_KEY --hote
# (procédure : LLM-Service/docs/brancher-une-application.md). Ne jamais la commiter.
LLM_API_KEY=
# Réflexion du modèle (Qwen3.5) : coupée par défaut. Mettre 1 pour l'activer.
LLM_THINKING=

# Stock initial de l'usine (sert à rendre la démo intéressante : il manquera des pièces)
# Format : piece:quantite séparés par des virgules
STOCK_INITIAL=roue:3,batterie:2,chassis:1

# Graine aléatoire pour le Fournisseur (vide = vrai aléatoire). Mettre un entier pour reproductibilité.
SEED=
